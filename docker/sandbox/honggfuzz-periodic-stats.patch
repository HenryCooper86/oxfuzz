+/* Publish telemetry independently of coverage discoveries and terminal UI. */
+static void writeStats(honggfuzz_t* hfuzz, bool final) {
+    static time_t lastWrite = 0;
+    const time_t curr_sec = time(NULL);
+    if (!hfuzz->io.statsFileName || (!final && curr_sec == lastWrite)) {
+        return;
+    }
+    lastWrite = curr_sec;
+    const time_t elapsed_sec = curr_sec - hfuzz->timing.timeStart;
+    size_t executions = ATOMIC_GET(hfuzz->cnts.mutationsCnt);
+    if (hfuzz->mutate.mutationsMax > 0 && executions > hfuzz->mutate.mutationsMax) {
+        executions = hfuzz->mutate.mutationsMax;
+    }
+    const size_t average = elapsed_sec > 0 ? executions / elapsed_sec : 0;
+    dprintf(hfuzz->io.statsFileFd,
+        "%lu, %lu, %lu, %lu, "
+        "%" PRIu64 ", %" PRIu64 ", %" PRIu64 ", %" PRIu64 ", %" PRIu64 "\n",
+        (unsigned long)curr_sec,
+        (unsigned long)ATOMIC_GET(hfuzz->timing.lastCovUpdate),
+        (unsigned long)executions, (unsigned long)average,
+        (uint64_t)ATOMIC_GET(hfuzz->cnts.crashesCnt),
+        (uint64_t)ATOMIC_GET(hfuzz->cnts.uniqueCrashesCnt),
+        (uint64_t)ATOMIC_GET(hfuzz->cnts.timeoutedCnt),
+        (uint64_t)ATOMIC_GET(hfuzz->feedback.hwCnts.softCntEdge),
+        (uint64_t)ATOMIC_GET(hfuzz->feedback.hwCnts.softCntPc));
+}
