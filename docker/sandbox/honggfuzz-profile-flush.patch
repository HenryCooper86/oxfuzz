diff --git a/libhfuzz/persistent.c b/libhfuzz/persistent.c
index 24e2a7a4..c6328f65 100644
--- a/libhfuzz/persistent.c
+++ b/libhfuzz/persistent.c
@@ -43,2 +43,6 @@ __attribute__((weak)) int LLVMFuzzerTestOneInput(
 static const uint8_t*                    inputFile = NULL;
+/* LLVM profile counters do not flush while the persistent process loops. */
+__attribute__((weak)) extern int  __llvm_profile_write_file(void);
+__attribute__((weak)) extern void __llvm_profile_reset_counters(void);
+static unsigned int                       profileWindowInputs = 0;
 __attribute__((constructor)) static void initializePersistent(void) {
@@ -69,2 +73,9 @@ static void              HonggfuzzRunOneInput(const uint8_t* buf, size_t len) {
     instrument8BitCountersCount();
+    if (getenv("LLVM_PROFILE_FILE") && __llvm_profile_write_file &&
+        __llvm_profile_reset_counters && ++profileWindowInputs >= 100) {
+        if (__llvm_profile_write_file() == 0) {
+            __llvm_profile_reset_counters();
+        }
+        profileWindowInputs = 0;
+    }
 }
