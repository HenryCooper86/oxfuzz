# ==============================================================================
# oxfuzz Environment Configuration
# Reference for the process environment. The Rust binaries do not load `.env`
# automatically; export these variables in the launching shell or service.
# ==============================================================================

# --- Execution safety (read these before anything else) ----------------------
# oxfuzz builds and runs untrusted, possibly malicious code. Three variables
# decide how much consent that needs. The defaults are the safe ones; every
# relaxation below is an explicit opt-in.
#
# Guardrail policy. Default (unset, or `strict`): high-risk actions -- compiling
# a generated harness, running one, launching a fuzzer -- require approval, and
# arbitrary shell execution is denied outright. `permissive` auto-approves
# everything with an audit log; use it only for trusted local loops.
# HF_GUARDRAILS=permissive
#
# Headless approval. With the default policy the approval gate reads this
# variable, so setting it to 1/true/yes/on lets an unattended run execute
# untrusted harnesses with no human in the loop. Leave it unset for anything
# you have not already decided to trust.
# HF_AUTO_APPROVE=1
#
# Sandbox selection. Unset or any value other than `0`/`false` uses the Docker
# sandbox when the daemon is reachable. Set to 0 to force the non-executing
# stub runtime, which makes every build and fuzz run fail closed rather than
# escape the sandbox. There is no configuration that runs a harness on the host.
# HF_USE_DOCKER=0

# --- LLM Provider -----------------------------------------------------------
# API key for your LLM provider (OpenAI, Anthropic, etc.)
HF_PROVIDER_API_KEY=sk-your-api-key-here

# Single-provider fallback used only when `config/providers.toml` is absent.
# HF_PROVIDER_MODEL=gpt-4o
# HF_PROVIDER_BASE_URL=https://api.openai.com/v1

# The REST API binds to 127.0.0.1 by default. Set a strong bearer token before
# using `oxfuzz serve --host` with any non-loopback address.
# HF_WEB_TOKEN=replace-with-a-long-random-token
# HF_WEB_TOKEN_OPTIONAL=1 # local development only; never with a remote bind
# VITE_API_TOKEN=replace-with-the-same-token # local browser build only

# Exact browser origins allowed to call the REST API (comma-separated).
HF_WEB_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Host project roots the web API may read. Use the platform path-list separator
# (`:` on Unix, `;` on Windows). Symlink and parent-traversal escapes are denied.
# HF_WEB_PROJECT_ROOTS=/path/to/approved/projects

# --- SQLite (Diagnostics & Runs) ---------------------------------------------
HF_DB_PATH=data/oxfuzz.db

# --- Logging -----------------------------------------------------------------
# Levels: error, warn, info, debug, trace
RUST_LOG=info

# --- Workspace and directories ------------------------------------------------
# Where fuzzing projects, corpora, and crashes are stored.
HF_WORKSPACE_DIR=/tmp/oxfuzz_workspace

# Config tree written by `oxfuzz init` and read on every start.
# HF_CONFIG_DIR=config
# Runtime state directory (defaults alongside the database).
# HF_DATA_DIR=data
# Destination for exported campaign reports.
# HF_REPORTS_DIR=reports

# --- Campaign automation (optional) -------------------------------------------
# These override `oxfuzz.toml`; the values shown are the built-in defaults.
# A coverage plateau is how a campaign learns a harness has stopped paying off.
# Seconds without new coverage before the run counts as stagnant.
# HF_COVERAGE_STAGNATION_SECS=120
# Consecutive stagnant windows before the campaign asks for a fresh harness.
# HF_COVERAGE_STAGNATION_NEW_HARNESS_WINDOWS=2
# Consecutive stagnant windows before it stops the run instead.
# HF_COVERAGE_STAGNATION_STOP_WINDOWS=4

# Automatic rollback of a harness revision that loses coverage against the
# previous one. Unset leaves rollback off.
# HF_AUTO_REVERT=1
# Coverage loss (percent) that triggers the revert.
# HF_AUTO_REVERT_THRESHOLD_PCT=20
# Report the regression without actually reverting.
# HF_AUTO_REVERT_NOTIFY_ONLY=1

# --- GitLab issue tracker (optional) ------------------------------------------
# Used to file triaged crashes as issues. Both are required together.
# HF_GITLAB_URL=https://gitlab.example.com
# HF_GITLAB_PROJECT=group/project

# --- DefectDojo (optional) ---------------------------------------------------
# API v2 token used to push triaged crashes as findings. The variable NAME is
# referenced by config/defectdojo.toml (api_token_env); set the URL there too.
# HF_DEFECTDOJO_TOKEN=your-defectdojo-api-token
