# ==============================================================================
# hobot_fuzz Environment Configuration
# Copy to .env and fill in your values: cp .env.example .env
# ==============================================================================

# --- LLM Provider -----------------------------------------------------------
# API key for your LLM provider (OpenAI, Anthropic, etc.)
HF_PROVIDER_API_KEY=sk-your-api-key-here

# --- Application Ports -------------------------------------------------------
HF_WEB_PORT=8081

# The REST API binds to 127.0.0.1 by default. Set a strong bearer token before
# using `hobot-fuzz serve --host` with any non-loopback address.
# HF_WEB_TOKEN=replace-with-a-long-random-token
# HF_WEB_TOKEN_OPTIONAL=1 # local development only; never with a remote bind
# VITE_API_TOKEN=replace-with-the-same-token # local browser build only

# Exact browser origins allowed to call the REST API (comma-separated).
HF_WEB_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Host project roots the web API may read. Use the platform path-list separator
# (`:` on Unix, `;` on Windows). Symlink and parent-traversal escapes are denied.
# HF_WEB_PROJECT_ROOTS=/path/to/approved/projects

# --- SQLite (Diagnostics & Runs) ---------------------------------------------
HF_DB_PATH=data/hobot_fuzz.db

# --- Logging -----------------------------------------------------------------
# Levels: error, warn, info, debug, trace
RUST_LOG=info

# --- Fuzzing Engines ---------------------------------------------------------
# Paths to engine binaries (auto-detected if unset)
# AFL_FUZZ_BIN=/usr/bin/afl-fuzz
# HONGGFUZZ_BIN=/usr/bin/honggfuzz
# LIBFUZZER_LINK_FLAGS=-fsanitize=fuzzer

# --- Workspace ---------------------------------------------------------------
# Where fuzzing projects, corpora, and crashes are stored.
HF_FUZZ_WORKSPACE=/tmp/hobot_fuzz_workspace

# --- DefectDojo (optional) ---------------------------------------------------
# API v2 token used to push triaged crashes as findings. The variable NAME is
# referenced by config/defectdojo.toml (api_token_env); set the URL there too.
# HF_DEFECTDOJO_TOKEN=your-defectdojo-api-token
