# hobot_fuzz PR fuzz gate (example).
#
# Copy to `.github/workflows/fuzz.yml` and adjust TARGET/ENGINE/DURATION.
# On each PR it: builds hobot-fuzz + the sandbox image, drafts & compiles a
# harness, fuzzes the target for a short budget, triages crashes, uploads SARIF
# to GitHub code scanning, and FAILS the check if any crash is found.
#
# Requirements:
#  - Docker available on the runner (ubuntu-latest has it).
#  - An LLM provider for harness drafting: set repo secret HF_PROVIDER_API_KEY
#    and a config/providers.toml (or rely on the heuristic harness fallback).

name: fuzz

on:
  pull_request:
    branches: [main]

permissions:
  contents: read
  security-events: write   # required to upload SARIF to code scanning

jobs:
  fuzz:
    runs-on: ubuntu-latest
    env:
      # The CI gate is a deliberate automated run.
      HF_GUARDRAILS: permissive
      HF_PROVIDER_API_KEY: ${{ secrets.HF_PROVIDER_API_KEY }}
      # ---- adjust these for your project ----
      TARGET: parse_image
      ENGINE: libfuzzer
      DURATION: 120s
      PROJECT: .
    steps:
      - uses: actions/checkout@v4

      - uses: dtolnay/rust-toolchain@1.94.0

      - name: Build hobot-fuzz
        run: cargo build --release -p hf-cli

      - name: Build the fuzzing sandbox image
        run: ./scripts/build-sandbox.sh

      - name: Fuzz gate
        run: |
          ./target/release/hobot-fuzz ci "$PROJECT" \
            --target "$TARGET" --engine "$ENGINE" \
            --duration "$DURATION" --sarif hobot_fuzz.sarif
        # `ci` exits non-zero on any crash, failing the check. SARIF is written
        # regardless so the upload step below can run.

      - name: Upload SARIF to code scanning
        if: always()
        uses: github/codeql-action/upload-sarif@v3
        with:
          sarif_file: hobot_fuzz.sarif
          category: hobot_fuzz
