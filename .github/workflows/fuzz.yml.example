# oxfuzz PR fuzz gate (example).
#
# Copy to `.github/workflows/fuzz.yml` and adjust TARGET/ENGINE/DURATION.
# On each PR it: builds oxfuzz + the sandbox image, fuzzes the target for a
# short budget, triages crashes, uploads SARIF to GitHub code scanning, and
# FAILS the check if any crash is found.
#
# The gate runs fuzzing and triage only; it does not draft or promote a
# harness. TARGET must already have a promoted harness, and its retained
# state (the oxfuzz database and workspace at the paths your config
# resolves) must be available on the runner -- a fresh checkout alone is
# not enough, since both directories are normally untracked.
#
# Requirements:
#  - Docker available on the runner (ubuntu-latest has it).
#  - A promoted harness for TARGET (see the Work Order flow in the CLI
#    Reference) with its database and workspace restored on the runner
#    (for example from an artifact or cache step you add).

name: fuzz

on:
  pull_request:
    branches: [main]

permissions:
  contents: read
  security-events: write   # required to upload SARIF to code scanning

jobs:
  fuzz:
    runs-on: ubuntu-latest
    env:
      # The CI gate is a deliberate automated run.
      HF_GUARDRAILS: permissive
      HF_PROVIDER_API_KEY: ${{ secrets.HF_PROVIDER_API_KEY }}
      # ---- adjust these for your project ----
      TARGET: parse_image
      ENGINE: libfuzzer
      DURATION: 120s
      PROJECT: .
    steps:
      - uses: actions/checkout@v7

      - uses: dtolnay/rust-toolchain@1.94.0

      - name: Build oxfuzz
        run: cargo build --release -p hf-cli

      - name: Build the fuzzing sandbox image
        run: ./scripts/build-sandbox.sh

      - name: Fuzz gate
        run: |
          ./target/release/oxfuzz ci "$PROJECT" \
            --target "$TARGET" --engine "$ENGINE" \
            --duration "$DURATION" --sarif oxfuzz.sarif
        # `ci` exits non-zero on any crash, failing the check. SARIF is written
        # regardless so the upload step below can run.

      - name: Upload SARIF to code scanning
        if: always()
        uses: github/codeql-action/upload-sarif@v3
        with:
          sarif_file: oxfuzz.sarif
          category: oxfuzz
